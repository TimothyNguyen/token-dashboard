[Unit]
Description=TokenDashboard (local token & cost dashboard)
After=network-online.target

[Service]
Type=simple

# NOTE: Set this to the absolute path of your token-dashboard binary.
# If you installed with `pip install --user token-dashboard`, this is often:
#   %h/.local/bin/token-dashboard
#
# If you installed in a venv, it is typically:
#   /path/to/venv/bin/token-dashboard
# `--no-open` keeps the headless service from trying to launch a browser.
ExecStart=%h/.local/bin/token-dashboard serve --bind 127.0.0.1 --port 55423 --no-open

Restart=on-failure
RestartSec=3

# Reduce log buffering so `journalctl -f` feels realtime.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

